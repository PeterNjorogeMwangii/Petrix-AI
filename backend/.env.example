APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@localhost:5432/petrix
SESSION_SIGNING_SECRET=
FRONTEND_ORIGIN=http://localhost:4200
API_BASE_URL=http://localhost:8000
MAGIC_LINK_MINUTES=15
SESSION_HOURS=168
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Petrix AI <hello@petrix.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
BLOCKED_EMAIL_DOMAINS=
SUPPORTED_COUNTRIES=
DEFAULT_COUNTRY=KE

# AI agent creation is unlimited for every workspace.
# Default languages per agent for newly created workspaces:
DEFAULT_LANGUAGE_LIMIT=3

# Optional OpenAI-compatible model connection for the conversation tester.
# Example base URL: https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_TESTER_REQUESTS_PER_MINUTE=20

# Message received: fuzzy -> semantic embeddings -> Groq intent recognition.
# The agent's LLM switch also controls the Groq intent stage.
INTENT_FUZZY_MARGIN=0.10
INTENT_SEMANTIC_ENABLED=true
INTENT_SEMANTIC_THRESHOLD=0.70
INTENT_SEMANTIC_MARGIN=0.08
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/embeddings
# Prepare the local model once: python -m app.workflows.matching.prepare_embeddings
# For a hosted embedding service, set EMBEDDING_PROVIDER=openai_compatible,
# supply its /v1 base URL, model name, and API key below.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=10

GROQ_API_KEY=
GROQ_INTENT_MODEL=openai/gpt-oss-20b
INTENT_LLM_ENABLED=true
INTENT_LLM_THRESHOLD=0.80
INTENT_LLM_TIMEOUT_SECONDS=15
INTENT_LLM_MAX_TOKENS=2048

# Optional exact hostnames for HTTPS APIs on private networks (no wildcards).
# Public API hosts need no entry. Metadata/link-local destinations stay blocked.
SEND_API_ALLOWED_PRIVATE_HOSTS=

# Optional stable Fernet key for database connection passwords. If empty, a
# separate encryption key is derived from SESSION_SIGNING_SECRET. Keep the key
# stable and back it up; rotating it requires re-entering connector passwords.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_CONNECTIONS_ENCRYPTION_KEY=

# Workflow LLM Processing shares GROQ_API_KEY and GROQ_INTENT_MODEL above.
LLM_PROCESSING_MAX_TOKENS=4096
