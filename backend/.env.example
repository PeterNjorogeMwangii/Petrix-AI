APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@localhost:5432/petrix
SESSION_SIGNING_SECRET=
FRONTEND_ORIGIN=http://localhost:4200
API_BASE_URL=http://localhost:8000
MAGIC_LINK_MINUTES=15
SESSION_HOURS=168
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Petrix AI <hello@petrix.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
BLOCKED_EMAIL_DOMAINS=
SUPPORTED_COUNTRIES=
DEFAULT_COUNTRY=KE

# AI agent creation is unlimited for every workspace.
# Default languages per agent for newly created workspaces:
DEFAULT_LANGUAGE_LIMIT=3

# Optional OpenAI-compatible model connection for the conversation tester.
# Example base URL: https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_TESTER_REQUESTS_PER_MINUTE=20

# Message received: fuzzy -> semantic embeddings -> Groq intent recognition.
# The agent's LLM switch also controls the Groq intent stage.
INTENT_FUZZY_MARGIN=0.10
INTENT_SEMANTIC_ENABLED=true
INTENT_SEMANTIC_THRESHOLD=0.70
INTENT_SEMANTIC_MARGIN=0.08
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/embeddings
# Prepare the local model once: python -m app.workflows.matching.prepare_embeddings
# For a hosted embedding service, set EMBEDDING_PROVIDER=openai_compatible,
# supply its /v1 base URL, model name, and API key below.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=10

GROQ_API_KEY=
GROQ_INTENT_MODEL=openai/gpt-oss-20b
INTENT_LLM_ENABLED=true
INTENT_LLM_THRESHOLD=0.80
INTENT_LLM_TIMEOUT_SECONDS=15
INTENT_LLM_MAX_TOKENS=2048

# Optional exact hostnames for HTTPS APIs on private networks (no wildcards).
# Public API hosts need no entry. Metadata/link-local destinations stay blocked.
SEND_API_ALLOWED_PRIVATE_HOSTS=

# Optional stable Fernet key for database connection passwords. If empty, a
# separate encryption key is derived from SESSION_SIGNING_SECRET. Keep the key
# stable and back it up; rotating it requires re-entering connector passwords.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_CONNECTIONS_ENCRYPTION_KEY=

# Workflow LLM Processing shares GROQ_API_KEY and GROQ_INTENT_MODEL above.
LLM_PROCESSING_MAX_TOKENS=4096

# Optional Workspace billing. Empty keys keep the self-hosted installation unmetered.
# See docs/WORKSPACE_SETTINGS.md before adding real prices or enabling auto top-up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCTS_JSON={}
USAGE_WEIGHTS_JSON={}

# Optional support summaries and Inbox co-pilot (OpenAI-compatible API base URL).
# Content is sent to the configured endpoint. Empty URL/model disables generation.
SUPPORT_AI_BASE_URL=
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=
# Optional comma-separated model IDs offered in Inbox Copilot settings; the default remains available.
SUPPORT_AI_MODELS=
SUPPORT_WORKER_ENABLED=true
SUPPORT_WORKER_INTERVAL=5

# Agent Knowledge imports. Automatic recovery is independent of support jobs.
KNOWLEDGE_WORKER_ENABLED=true
# Optional informational public outbound IP shown to website owners in Guidance.
KNOWLEDGE_EGRESS_IP=
# Optional server-owned OpenAI-compatible /moderations service.
# When connected, generated agent replies and workflow LLM Processing are screened.
# Required=true blocks model use when the service is missing/unavailable.
MODERATION_BASE_URL=
MODERATION_API_KEY=
MODERATION_MODEL=
MODERATION_REQUIRED=false

# Optional normalized mail-provider adapter; empty disables incoming mail/receipts.
# Use a separate random secret of at least 32 characters. See docs/TICKETS.md.
TICKET_MAIL_WEBHOOK_SECRET=

# Perception public collection adapter (exact POST endpoint, server owned).
# Facebook/X require a service with authorized platform access. See docs/PERCEPTION.md.
PERCEPTION_PROVIDER_URL=
PERCEPTION_PROVIDER_TOKEN=
PERCEPTION_WORKER_ENABLED=true

# Optional Advisor model. Empty dedicated settings reuse support AI, then tester LLM.
# Without any model Advisor provides bundled documentation guidance.
ADVISOR_BASE_URL=
ADVISOR_API_KEY=
ADVISOR_MODEL=
# Enable only for a chat-completions model that accepts image_url content.
ADVISOR_VISION_ENABLED=false
ADVISOR_WORKER_ENABLED=true

# Public Webchat timeout processing (enabled in API processes by default).
# Use false when a separate python -m app.webchat.worker --watch process is running.
WEBCHAT_WORKER_ENABLED=true
# For website embeds, API_BASE_URL above must be the externally reachable HTTPS API origin.

# WhatsApp publishing: Meta credentials are entered privately in Publish.
WHATSAPP_WORKER_ENABLED=true
WHATSAPP_GRAPH_VERSION=v27.0
# Set API_BASE_URL above to your publicly reachable HTTPS API origin.
# Keep SESSION_SIGNING_SECRET stable to decrypt stored channel credentials.
